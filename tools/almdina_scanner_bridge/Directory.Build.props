<Project>
  <PropertyGroup>
    <ScannerBridgeVersion>2.1.0</ScannerBridgeVersion>
    <Version>$(ScannerBridgeVersion)</Version>
    <Company>Almdina ERP</Company>
    <Product>Almdina Scanner Bridge</Product>
    <Copyright>Copyright © Almdina ERP</Copyright>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
